# Derma Clinic Management System production configuration example
# Copy to a secret-managed environment. Do not commit real values.

APP_ENV=production
FRONTEND_PUBLIC_URL=https://clinic.example.com

# MySQL 8+
DB_HOST=mysql.example.internal
DB_PORT=3306
DB_NAME=derma_clinic
DB_USER=derma_app
DB_PASSWORD=replace-in-secret-manager

# Authentication secrets: generate with a cryptographically secure tool.
JWT_SECRET=replace-with-at-least-256-bit-secret
JWT_ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# Encryption and integrations
AES256_KEY=replace-with-32-byte-secret
CORS_ALLOWED_ORIGINS=https://clinic.example.com

# Operational settings
LOG_LEVEL=INFO
BACKUP_BUCKET=replace-with-private-backup-location
