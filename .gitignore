# Build output. Regenerated by `mvn package`; never edited by hand.
# Committing it means every build re-commits hundreds of .class files that no reviewer can read.
backend/target/
target/

# Local secrets. .env.example is the committed template; a real .env never is.
.env
*.env
!.env.example

# Local database dumps. These contain patient records and must never be committed.
# Deliberately not a blanket *.sql - that would ignore the Flyway migrations in
# backend/src/main/resources/db/migration and the tracked scripts in database/.
*_backup.sql
dcms_backup.sql

# Python scratch environment, used only by one-off hashing scripts.
.venv/
__pycache__/
*.pyc

# Logs and runtime output.
*.log
logs/

# Editor and OS noise.
.idea/
*.iml
.DS_Store
Thumbs.db
